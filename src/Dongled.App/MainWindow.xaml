<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Dongled.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tb="using:H.NotifyIcon"
    Title="Dongled">

    <Grid>
        <tb:TaskbarIcon
            x:Name="TrayIcon"
            ToolTipText="{x:Bind Shell.TrayToolTip, Mode=OneWay}"
            DoubleClickCommand="{x:Bind ShowWindowCommand}">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Open" Command="{x:Bind ShowWindowCommand}" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Exit" Command="{x:Bind ExitCommand}" />
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- The draggable title bar. The window extends its content into the caption area, so
                 this element is what SetTitleBar hands to Windows as the drag region; without it the
                 window could only be moved by its edges. Left inset by 48px so the text clears the
                 NavigationView's back/menu button. -->
            <Grid x:Name="AppTitleBar" Grid.Row="0" Height="40">
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="10"
                    VerticalAlignment="Center"
                    Margin="16,0,0,0">
                    <Image
                        Source="ms-appx:///Assets/TrayIcon.ico"
                        Width="16"
                        Height="16"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Text="Dongled"
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
            </Grid>

            <NavigationView
                x:Name="Nav"
                Grid.Row="1"
                IsBackButtonVisible="Collapsed"
                IsSettingsVisible="False"
                PaneDisplayMode="Left"
                OpenPaneLength="200"
                SelectionChanged="OnNavigationSelectionChanged">

                <NavigationView.MenuItems>
                    <NavigationViewItem Content="Status" Tag="Status" IsSelected="True">
                        <NavigationViewItem.Icon>
                            <SymbolIcon Symbol="Audio" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Rules" Tag="Rules">
                        <NavigationViewItem.Icon>
                            <SymbolIcon Symbol="Sync" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Plugins" Tag="Plugins">
                        <NavigationViewItem.Icon>
                            <SymbolIcon Symbol="Repair" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Battery" Tag="Battery">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE83F;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Logs" Tag="Logs">
                        <NavigationViewItem.Icon>
                            <SymbolIcon Symbol="List" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.MenuItems>

                <NavigationView.FooterMenuItems>
                    <NavigationViewItem Content="Settings" Tag="Settings">
                        <NavigationViewItem.Icon>
                            <SymbolIcon Symbol="Setting" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.FooterMenuItems>

                <Frame x:Name="ContentFrame" />
            </NavigationView>
        </Grid>
    </Grid>
</Window>
