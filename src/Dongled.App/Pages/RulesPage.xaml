<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Dongled.App.Pages.RulesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Dongled.App.ViewModels">

    <Grid Margin="28" ColumnSpacing="24" RowSpacing="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Text="Rules"
            Style="{StaticResource TitleTextBlockStyle}" />

        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Spacing="8">
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasProblem, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.HasProblem, Mode=OneWay}"
                IsClosable="False"
                Severity="Error"
                Message="{x:Bind ViewModel.Problem, Mode=OneWay}" />
        </StackPanel>

        <!-- The list of rules -->
        <Grid Grid.Row="2" Grid.Column="0" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                <Button Content="Add rule" Command="{x:Bind ViewModel.AddRuleCommand}" />
                <Button
                    Content="Delete"
                    Command="{x:Bind ViewModel.DeleteRuleCommand}"
                    IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}" />
            </StackPanel>

            <Grid Grid.Row="1">
                <TextBlock
                    Opacity="0.7"
                    TextWrapping="Wrap"
                    VerticalAlignment="Top"
                    Visibility="{x:Bind ViewModel.HasNoRules, Mode=OneWay}"
                    Text="No rules yet. Add one to switch your default device when a headset connects." />

                <ListView
                    ItemsSource="{x:Bind ViewModel.Rules, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedRule, Mode=TwoWay}"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:RuleListItem">
                            <StackPanel Padding="0,8" Spacing="2">
                                <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                <TextBlock
                                    Text="{x:Bind Summary}"
                                    Opacity="0.6"
                                    TextWrapping="Wrap"
                                    Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <!-- The editor, which reads as a sentence -->
        <ScrollViewer
            Grid.Row="2"
            Grid.Column="1"
            Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}">

            <StackPanel Spacing="18" MaxWidth="560" HorizontalAlignment="Left">

                <TextBox
                    Header="Name"
                    PlaceholderText="Headset"
                    Text="{x:Bind ViewModel.Editor.RuleName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <ToggleSwitch
                    Header="Switched on"
                    IsOn="{x:Bind ViewModel.Editor.RuleEnabled, Mode=TwoWay}" />

                <InfoBar
                    IsOpen="{x:Bind ViewModel.HasValidation, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.HasValidation, Mode=OneWay}"
                    IsClosable="False"
                    Severity="Warning"
                    Message="{x:Bind ViewModel.Validation, Mode=OneWay}" />

                <StackPanel Spacing="10">
                    <TextBlock Text="When this connects" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ComboBox
                        HorizontalAlignment="Stretch"
                        PlaceholderText="Choose a source"
                        ItemsSource="{x:Bind ViewModel.Editor.SourceChoices, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.Editor.SelectedSource, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Spacing="10">
                    <TextBlock Text="Make this the default" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ComboBox
                        HorizontalAlignment="Stretch"
                        PlaceholderText="Choose a playback device"
                        ItemsSource="{x:Bind ViewModel.Editor.DeviceChoices, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.Editor.SelectedTarget, Mode=TwoWay}" />

                    <CheckBox Content="Match by name" IsChecked="{x:Bind ViewModel.Editor.TargetMatch.UsesPattern, Mode=TwoWay}" />
                    <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.Editor.TargetMatch.UsesPattern, Mode=OneWay}">
                        <TextBox
                            FontFamily="Consolas"
                            PlaceholderText="A regular expression, such as ^Headset"
                            Text="{x:Bind ViewModel.Editor.TargetMatch.Pattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock
                            TextWrapping="Wrap"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.Editor.TargetMatch.Status, Mode=OneWay}" />
                        <TextBlock
                            Opacity="0.6"
                            TextWrapping="Wrap"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Switches to whichever connected device's name matches, ignoring case, so the rule keeps working if Windows renumbers the device. Picking a device above fills this in, and that device is preferred when several match." />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="18">
                        <CheckBox Content="Media" IsChecked="{x:Bind ViewModel.Editor.MediaSelected, Mode=TwoWay}" />
                        <CheckBox Content="Calls" IsChecked="{x:Bind ViewModel.Editor.CallsSelected, Mode=TwoWay}" />
                    </StackPanel>
                    <TextBlock
                        Opacity="0.6"
                        TextWrapping="Wrap"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Both are ticked by default, which is what the app has always done. Unticking one leaves that role where it is." />
                </StackPanel>

                <StackPanel Spacing="10">
                    <TextBlock Text="When it disconnects" Style="{StaticResource SubtitleTextBlockStyle}" />

                    <ComboBox
                        HorizontalAlignment="Stretch"
                        SelectedIndex="{x:Bind ViewModel.Editor.DisconnectModeIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="Go back to whatever was default before, or a specific device if that's gone" />
                        <ComboBoxItem Content="Always switch to a specific device" />
                        <ComboBoxItem Content="Go back to whatever was default before" />
                        <ComboBoxItem Content="Leave it alone" />
                    </ComboBox>

                    <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.Editor.FallbackApplies, Mode=OneWay}">
                        <TextBlock Text="…the specific device" Opacity="0.7" />
                        <ComboBox
                            HorizontalAlignment="Stretch"
                            ItemsSource="{x:Bind ViewModel.Editor.FallbackChoices, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.Editor.SelectedFallback, Mode=TwoWay}" />

                        <CheckBox Content="Match by name" IsChecked="{x:Bind ViewModel.Editor.FallbackMatch.UsesPattern, Mode=TwoWay}" />
                        <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.Editor.FallbackMatch.UsesPattern, Mode=OneWay}">
                            <TextBox
                                FontFamily="Consolas"
                                PlaceholderText="A regular expression, such as ^Speakers"
                                Text="{x:Bind ViewModel.Editor.FallbackMatch.Pattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                TextWrapping="Wrap"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.Editor.FallbackMatch.Status, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <NumberBox
                            Header="After waiting this many seconds"
                            Minimum="0"
                            Maximum="300"
                            SpinButtonPlacementMode="Compact"
                            Value="{x:Bind ViewModel.StabilizationSeconds, Mode=TwoWay}" />
                        <TextBlock
                            Opacity="0.6"
                            TextWrapping="Wrap"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="This wait applies to every rule, not just this one. It stops a headset that flickers off and on from causing a switch." />
                    </StackPanel>
                </StackPanel>

                <TextBlock
                    Opacity="0.6"
                    TextWrapping="Wrap"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Changes are saved as you make them." />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
