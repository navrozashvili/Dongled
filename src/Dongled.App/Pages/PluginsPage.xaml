<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Dongled.App.Pages.PluginsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Dongled.App.ViewModels">

    <Grid Margin="28" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Plugins" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    Opacity="0.6"
                    TextWrapping="Wrap"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="One folder per plugin, beside the app. Everything found is listed, including folders that are not plugins." />
            </StackPanel>

            <Button
                Grid.Column="1"
                Content="Add plugin…"
                VerticalAlignment="Top"
                Command="{x:Bind ViewModel.AddPluginCommand}" />
        </Grid>

        <StackPanel Grid.Row="1" Spacing="8">
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasProblem, Mode=OneWay}"
                IsClosable="False"
                Severity="Error"
                Message="{x:Bind ViewModel.Problem, Mode=OneWay}" />
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasNotice, Mode=OneWay}"
                IsClosable="True"
                Severity="Informational"
                Message="{x:Bind ViewModel.Notice, Mode=OneWay}" />

            <!--
                Its own bar rather than an action on the notice above: that notice is dismissible and
                is replaced by whatever the user does next, while this one is not closable and stays
                until the restart it asks for happens.
            -->
            <InfoBar
                IsOpen="{x:Bind ViewModel.NeedsRestart, Mode=OneWay}"
                IsClosable="False"
                Severity="Informational"
                Title="Restart to apply"
                Message="Plugins are loaded once, at startup, so what you changed takes effect on the next start.">
                <InfoBar.ActionButton>
                    <Button
                        Content="Restart now"
                        Command="{x:Bind ViewModel.RestartCommand}" />
                </InfoBar.ActionButton>
            </InfoBar>
            <ProgressBar
                IsIndeterminate="True"
                Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
            <TextBlock
                Opacity="0.7"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.HasNoRows, Mode=OneWay}"
                Text="There are no folders in the plugins directory." />
        </StackPanel>

        <ListView
            Grid.Row="2"
            ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}"
            SelectionMode="None"
            IsItemClickEnabled="False">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:PluginRow">
                    <Grid Padding="0,10" ColumnSpacing="14" RowSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" FontWeight="SemiBold" />
                            <Border
                                Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                CornerRadius="4"
                                Padding="6,1"
                                VerticalAlignment="Center"
                                Visibility="{x:Bind IsExperimental}">
                                <TextBlock Text="Experimental" Style="{StaticResource CaptionTextBlockStyle}" />
                            </Border>
                            <Border
                                Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                CornerRadius="4"
                                Padding="6,1"
                                VerticalAlignment="Center"
                                Visibility="{x:Bind IsBundled}"
                                ToolTipService.ToolTip="These are exactly the files shipped with this version of Dongled, so they load without an approval. Switching the plugin off still keeps it off.">
                                <TextBlock Text="Trusted: shipped with Dongled" Style="{StaticResource CaptionTextBlockStyle}" />
                            </Border>
                        </StackPanel>

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="1"
                            Text="{x:Bind Status}"
                            Opacity="0.8"
                            VerticalAlignment="Center" />

                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Spacing="2">
                            <TextBlock
                                Text="{x:Bind Description}"
                                Visibility="{x:Bind HasDescription}"
                                Opacity="0.7"
                                TextWrapping="Wrap"
                                Style="{StaticResource CaptionTextBlockStyle}" />
                            <TextBlock
                                Text="{x:Bind Message}"
                                Opacity="0.6"
                                TextWrapping="Wrap"
                                Style="{StaticResource CaptionTextBlockStyle}" />
                            <TextBlock
                                Text="{x:Bind Directory}"
                                Opacity="0.5"
                                TextWrapping="Wrap"
                                Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>

                        <StackPanel
                            Grid.Row="2"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Orientation="Horizontal"
                            Spacing="10">

                            <Button
                                Content="Enable…"
                                Visibility="{x:Bind CanApprove}"
                                Command="{x:Bind ApproveCommand}"
                                CommandParameter="{x:Bind}" />

                            <Button
                                Content="Switch off"
                                Visibility="{x:Bind CanDisable}"
                                Command="{x:Bind DisableCommand}"
                                CommandParameter="{x:Bind}" />

                            <ComboBox
                                MinWidth="150"
                                Visibility="{x:Bind CanChooseLogLevel}"
                                SelectedIndex="{x:Bind LogLevelIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="Log: Debug" />
                                <ComboBoxItem Content="Log: Information" />
                                <ComboBoxItem Content="Log: Warnings" />
                                <ComboBoxItem Content="Log: Errors" />
                            </ComboBox>

                            <Button
                                Content="Remove"
                                Visibility="{x:Bind CanRemove}"
                                Command="{x:Bind RemoveCommand}"
                                CommandParameter="{x:Bind}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
