<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Dongled.App.Pages.BatteryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Dongled.App.ViewModels">

    <ScrollViewer>
        <StackPanel Margin="28" Spacing="22" MaxWidth="760" HorizontalAlignment="Center">

            <TextBlock Text="Battery" Style="{StaticResource TitleTextBlockStyle}" />

            <InfoBar
                IsOpen="{x:Bind ViewModel.HasProblem, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.HasProblem, Mode=OneWay}"
                IsClosable="False"
                Severity="Error"
                Message="{x:Bind ViewModel.Problem, Mode=OneWay}" />

            <TextBlock
                Opacity="0.7"
                TextWrapping="Wrap"
                Text="The notification-area icon shows the first device in this list that is connected and reporting a level. Devices that are switched off stay listed, so you can put them in order for when they come back." />

            <TextBlock
                Opacity="0.7"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.HasNoBatterySources, Mode=OneWay}"
                Text="No plugin reports a battery. Enable one on the Plugins page." />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Move up" Command="{x:Bind ViewModel.MoveUpCommand}" />
                <Button Content="Move down" Command="{x:Bind ViewModel.MoveDownCommand}" />
            </StackPanel>

            <ListView
                ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedRow, Mode=TwoWay}"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:BatteryRow">
                        <Grid ColumnSpacing="10" Padding="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{x:Bind Name, Mode=OneWay}" TextWrapping="Wrap" />
                                <TextBlock
                                    Text="{x:Bind Detail, Mode=OneWay}"
                                    Visibility="{x:Bind HasDetail, Mode=OneWay}"
                                    Opacity="0.6"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Text="{x:Bind State, Mode=OneWay}"
                                    Opacity="0.6"
                                    Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>

                            <TextBlock Grid.Column="1" Text="{x:Bind Level, Mode=OneWay}" VerticalAlignment="Center" />

                            <TextBlock
                                Grid.Column="2"
                                Text="in tray"
                                Opacity="0.7"
                                VerticalAlignment="Center"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Visibility="{x:Bind IsTrayPick, Mode=OneWay}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
