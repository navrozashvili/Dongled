<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Dongled.Core</RootNamespace>
    <AssemblyName>Dongled.Core</AssemblyName>
    <Description>Audio endpoints, switching policy, configuration, and the plugin host.</Description>
    <!-- Source-generated COM interop ([GeneratedComInterface]) emits unsafe code. -->
