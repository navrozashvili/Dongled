  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dongled.Abstractions\Dongled.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

</Project>
