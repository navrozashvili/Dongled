<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>Dongled.App.Tests</RootNamespace>
    <!-- The App is built self-contained; the test host must not be. -->
    <SelfContained>false</SelfContained>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>false</UseWinUI>
    <!-- Required (suppresses NETSDK1151): xunit v3 is a Microsoft.Testing.Platform
         framework, so the SDK does not waive this validation the way it does for
         VSTest projects, and referencing the self-contained App project would
         otherwise be rejected. -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Dongled.App\Dongled.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\src\Dongled.App\Assets\TrayIcon.ico"
             Link="Assets\TrayIcon.ico"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
