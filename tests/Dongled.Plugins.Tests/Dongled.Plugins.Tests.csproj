<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Dongled.Plugins.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Dongled.Abstractions\Dongled.Abstractions.csproj" />
    <!-- Real references, unlike Core.Tests' staged copies. These tests drive a provider's internals
         directly, which needs a compile-time reference; the loader tests that must NOT have the
         plugin sitting beside the test assembly are in Core.Tests, because one project cannot both
         reference and not-reference the same project. -->
    <ProjectReference Include="..\..\plugins\Dongled.Plugin.HyperXHid\Dongled.Plugin.HyperXHid.csproj" />
    <ProjectReference Include="..\..\plugins\Dongled.Plugin.Logitech\Dongled.Plugin.Logitech.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

</Project>
